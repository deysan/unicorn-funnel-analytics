{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unicorn-local",
  "main": "src/server/index.ts",
  // Найновіша дата, яку підтримує встановлений локальний workerd.
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/report", "/report/*"]
  },
  "secrets": { "required": ["COMMAND_HMAC_SECRET", "IP_HMAC_SECRET", "PARTNER_TOKENS", "REPORT_USERNAME", "REPORT_PASSWORD"] },
  "vars": {
    "LOCAL_RUNTIME": "true",
    "ALLOWED_ORIGINS": "https://localhost:5173,https://localhost:4173,https://127.0.0.1:5173,https://127.0.0.1:4173,http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173"
  },
  "ratelimits": [
    {"name":"QUIZ_IP_LIMITER","namespace_id":"1001","simple":{"limit":300,"period":60}},
    {"name":"QUIZ_USER_LIMITER","namespace_id":"1002","simple":{"limit":120,"period":60}},
    {"name":"BOOTSTRAP_LIMITER","namespace_id":"1003","simple":{"limit":10,"period":60}},
    {"name":"PARTNER_IP_LIMITER","namespace_id":"1004","simple":{"limit":300,"period":60}},
    {"name":"PARTNER_ID_LIMITER","namespace_id":"1005","simple":{"limit":30,"period":60}},
    {"name":"REPORT_IP_LIMITER","namespace_id":"1006","simple":{"limit":300,"period":60}},
    {"name":"REPORT_LIMITER","namespace_id":"1007","simple":{"limit":30,"period":60}}
  ],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "unicorn-local",
    // Локальний ідентифікатор. Хмарну базу ще не створено.
    "database_id": "00000000-0000-4000-8000-000000000001",
    "remote": false
  }]
}
