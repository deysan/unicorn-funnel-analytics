{
  "name": "unicorn-funnel-analytics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "npm run setup:local && vite --host localhost",
    "types": "wrangler types src/server/worker-configuration.d.ts",
    "typecheck": "npm run types && tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.shared.json && tsc -p tsconfig.node.json && tsc -p tsconfig.tests-worker.json && tsc -p tsconfig.tests-browser.json",
    "build": "vite build",
    "preview": "vite preview --host localhost",
    "test:smoke": "node scripts/run-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:smoke",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "setup:local": "node scripts/setup-local.mjs",
    "precheck": "node scripts/setup-local.mjs --secrets-only",
    "prebuild": "node scripts/setup-local.mjs --secrets-only",
    "partner": "node scripts/partner-cli.ts",
    "demo:config": "node scripts/demo-config.ts generate",
    "demo:guard": "node scripts/demo-config.ts check",
    "build:demo": "npm run demo:guard && vite build --mode demo && node scripts/demo-artifact.ts seal",
    "demo:schema:sql": "node scripts/demo-schema.ts sql",
    "demo:schema:check": "node scripts/demo-schema.ts check",
    "demo:smoke": "node scripts/demo-smoke.mjs",
    "demo:release:guard": "node scripts/demo-artifact.ts release"
  },
  "dependencies": {
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/vitest-plugin": "1.4.11",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
