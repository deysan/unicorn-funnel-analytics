{
  "name": "unicorn-funnel-analytics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.22.2", "npm": "11.19.1" },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "types": "wrangler types src/server/worker-configuration.d.ts",
    "typecheck": "npm run types && tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.shared.json && tsc -p tsconfig.node.json",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:smoke": "playwright test",
    "check": "npm run typecheck && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.156.0"
  }
}
